---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/rubik';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const podglad = import.meta.env.PUBLIC_PODGLAD === '1';
// Przy build.format 'file' Astro.url.pathname ma końcówkę .html (/oferta.html, /index.html), a serwer
// przekierowuje ją na adres bez końcówki. Kanoniczny musi być adresem docelowym: /oferta, / (09.11.2026,
// Search Console: „Page with redirect” i „Google chose different canonical”).
const kanoniczny = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
---
<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={kanoniczny} />
		{podglad && <meta name="robots" content="noindex, nofollow" />}
		<!-- Baner cookies easy.tools: licencja Roberta, kod z Framera (31.10.2026).
		     defer (07.11.2026): skrypt i tak czeka na DOMContentLoaded, a bez defer blokował
		     renderowanie strony o ~0,8 s (PageSpeed, telefon). -->
		<script is:inline defer src="https://app.easy.tools/cookies/scripts/ddeab2d06e484e8683c263d9f50d8e56.js"></script>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
